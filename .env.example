# ====================================================================
# SynaptiQ Environment Variables Template
# Copy this file to .env.local and populate with your credentials
# ====================================================================

# Supabase (Auth + PostgreSQL Database)
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OpenRouter AI (AxonBuddy Tutoring & Question Generation)
# Found in: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: Supabase Service Role Key (Server-side admin operations only)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

